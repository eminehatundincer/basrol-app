# Bu dosyayı .env olarak kopyala. .env asla paylaşılmaz / git'e eklenmez.

# mock = demo (örnek video, ücret çıkmaz) | higgsfield = gerçek video
VIDEO_PROVIDER=mock

# Higgsfield API bilgileri (dokümantasyona göre isimleri netleşecek)
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# Admin hesabı: sunucu her açılışta bu bilgilerle admin hesabını oluşturur/günceller.
ADMIN_EMAIL=admin@fotovideo.test
ADMIN_PASSWORD=

# Google Play ödeme bağlanana kadar mağazadaki paketler ücretsiz kredi yükler. Canlıda false yap.
ALLOW_DEV_PURCHASES=true

# Test modu: giriş ekranı olmadan, sınırsız kredili test hesabıyla açılır. Canlıda false yap.
DEV_AUTO_LOGIN=true

PORT=3000
